+    def _normalize_constraint_names(
+        self, arg_name: str, names: cabc.Sequence[str] | None
+    ) -> tuple[str, ...]:
+        """Validate a ``requires`` or ``conflicts_with`` argument and store it as a
+        tuple of parameter names.
+        """
+        if names is None:
+            return ()
+
+        if isinstance(names, str):
+            raise TypeError(
+                f"'{arg_name}' must be a sequence of parameter names, not a string."
+            )
+
+        result = tuple(names)
+
+        if self.name in result:
+            raise ValueError(f"Option '{self.name}' cannot refer to itself.")
