+def _check_option_constraints(ctx: Context, params: cabc.Sequence[Parameter]) -> None:
+    """Enforce ``Option.conflicts_with`` and ``Option.requires`` for every explicit
+    option, in declaration order. Only explicit values (command line, environment,
+    or prompt) count, so defaults and ``default_map`` values neither trigger nor
+    satisfy a constraint. The first violation raises :meth:`Context.fail`.
+    """
+    by_name: dict[str, Parameter] = {param.name: param for param in params}
+
+    def is_explicit(name: str) -> bool:
+        source = ctx.get_parameter_source(name)
+        return source is not None and source < ParameterSource.DEFAULT_MAP
+
+    def display(param: Parameter) -> str:
+        return max(param.opts, key=len) if param.opts else param.name
+
+    for param in params:
+        if not isinstance(param, Option):
+            continue
+
+        if not (param.conflicts_with or param.requires):
+            continue
+
+        if not is_explicit(param.name):
+            continue
+
+        for other_name in param.conflicts_with:
+            other = by_name.get(other_name)
+
+            if other is None:
+                raise TypeError(
+                    f"Option '{param.name}' refers to unknown parameter '{other_name}'."
+                )
+
+            if is_explicit(other_name):
+                ctx.fail(
+                    f"Option '{display(param)}' cannot be used with '{display(other)}'."
+                )
+
+        for other_name in param.requires:
+            other = by_name.get(other_name)
+
+            if other is None:
+                raise TypeError(
+                    f"Option '{param.name}' refers to unknown parameter '{other_name}'."
+                )
+
+            if not is_explicit(other_name):
+                ctx.fail(f"Option '{display(param)}' requires '{display(other)}'.")
 
 
