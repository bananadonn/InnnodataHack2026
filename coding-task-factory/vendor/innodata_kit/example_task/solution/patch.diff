+def truncate(text, limit, suffix="…"):
+    """Shorten *text* to at most *limit* characters.
+
+    If ``len(text) <= limit`` the text is returned unchanged. Otherwise the
+    result is exactly *limit* characters long and ends with *suffix*. When
+    *limit* is not larger than the suffix, only the first *limit* characters of
+    the suffix are returned. A negative *limit* raises ``ValueError``.
+    """
+    if limit < 0:
+        raise ValueError("limit must be non-negative")
+    if len(text) <= limit:
+        return text
+    if limit <= len(suffix):
+        return suffix[:limit]
+    return text[: limit - len(suffix)] + suffix
