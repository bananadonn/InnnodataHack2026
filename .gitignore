# secrets
.env

# python
.venv/
__pycache__/
*.pyc

# OS junk
.DS_Store
._*

# local click clone (never commit; the Dockerfile clones it)
/click/

# raw harbor run dirs (root only, so results/bench/ stays tracked)
/sc/
/bench/

# logs: ignored everywhere except under results/
*.log
!results/**/*.log

# exploration runs: keep reports and logs, never the cloned repos
/runs/*/repo/
